{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brain IDE",
  "version": "0.1.0",
  "identifier": "com.brain.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "Brain IDE",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https: data: blob:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com tauri:;"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 Brain IDE contributors",
    "shortDescription": "Multi-agent orchestrator IDE built on the brain memory layer.",
    "longDescription": "Brain IDE turns a free-form spec into a graph of feature cards you can drag onto Claude, Codex, shell sessions, or human reviewers. All agents share one git-backed brain memory.",
    "publisher": "Brain IDE",
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "providerShortName": null
    }
  },
  "plugins": {}
}
